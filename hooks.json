{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|replace_in_file|MultiEdit|Write|Edit|run_command|bash|Bash|execute_command|run_terminal_cmd)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"{{PLUGIN_DIR}}/hooks/pre-edit-audit.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|replace_in_file|MultiEdit|Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"{{PLUGIN_DIR}}/hooks/post-edit-slop.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
